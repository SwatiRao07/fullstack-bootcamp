{
  "name": "database-drills-testing",
  "version": "1.0.0",
  "description": "Database Advanced Drills - Testing, Seeding, Backup, Performance, Monitoring",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:sqlite": "DB_TYPE=sqlite SQLITE_PATH=./test.db tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "db:reset:sqlite": "DB_TYPE=sqlite SQLITE_PATH=./test.db tsx src/scripts/reset.ts",
    "backup": "bash src/scripts/backup.sh",
    "restore": "bash src/scripts/restore.sh"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.5",
    "@types/pg": "^8.18.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
